        "    }\n",
        "\n",
        "\n",
        "def decode_validated_roi(roi):\n",
        "    if roi is None or roi.size == 0:\n",
        "        return {\n",
        "            \"decoded\": False,\n",
        "            \"value\": \"\",\n",
        "            \"type\": \"Não identificado\",\n",
        "            \"decoder\": \"Nenhum\",\n",
