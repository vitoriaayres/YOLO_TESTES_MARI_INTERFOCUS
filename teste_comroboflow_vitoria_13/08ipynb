        "            and signature[\"valid_row_ratio\"]\n",
        "            >= config[\"candidate_min_valid_row_ratio\"]\n",
        "            and signature[\"direction_ratio\"]\n",
        "            >= config[\"candidate_min_direction_ratio\"]\n",
        "            and signature[\"score\"]\n",
        "            >= config[\"candidate_min_signature_score\"]\n",
        "        )\n",
        "    )\n"
